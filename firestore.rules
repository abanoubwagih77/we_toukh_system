rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /teachers/{teacherId} {
      allow read, write: if true;
    }
    match /missions/{missionId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
